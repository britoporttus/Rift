PORT=3001
# OBRIGATÓRIO: >= 32 chars aleatórios. O backend aborta o boot se ausente/fraco.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRAMEWORK_PATH=/home/digitalbath/pentest-framework-v2
ADMIN_EMAIL=admin@rift.local
# OBRIGATÓRIO para o seed: >= 10 chars, sem valores triviais (o seed recusa senha fraca).
# Gere com: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=
MONGO_URI=mongodb://127.0.0.1:27017/rift

# Teto de custo (US$) por run interativo do chat (SEC-2). 0 = sem teto.
INTERACTIVE_COST_CEILING=10
# Tempo máximo (ms) de um run do agente antes de matar a árvore de processos (REL-2).
RUN_TIMEOUT_MS=2700000
# Domínios de e-mail permitidos no SSO Microsoft (validado no servidor).
ALLOWED_EMAIL_DOMAINS=porttus.com,trustsis.com
# Or use a pre-hashed password (bcrypt):
# ADMIN_PASSWORD_HASH=$2b$10$...
# Comma-separated list of extra allowed origins (cloudflare URL, etc.)
# ALLOWED_ORIGINS=http://localhost:3000,https://rift.example.trycloudflare.com
