PORT=3001
# OBRIGATÓRIO: >= 32 chars aleatórios. O backend aborta o boot se ausente/fraco.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRAMEWORK_PATH=/home/digitalbath/pentest-framework-v2
ADMIN_EMAIL=admin@rift.local
# OBRIGATÓRIO para o seed: >= 10 chars, sem valores triviais (o seed recusa senha fraca).
# Gere com: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=
MONGO_URI=mongodb://127.0.0.1:27017/rift

# Teto de custo (US$) por run interativo do chat (SEC-2). 0 = sem teto.
INTERACTIVE_COST_CEILING=10
# Tempo máximo (ms) de um run do agente antes de matar a árvore de processos (REL-2).
RUN_TIMEOUT_MS=2700000
# Domínios de e-mail permitidos no SSO Microsoft (validado no servidor).
ALLOWED_EMAIL_DOMAINS=porttus.com,trustsis.com
# Or use a pre-hashed password (bcrypt):
# ADMIN_PASSWORD_HASH=$2b$10$...
# Comma-separated list of extra allowed origins (cloudflare URL, etc.)
# ALLOWED_ORIGINS=http://localhost:3000,https://rift.example.trycloudflare.com
# P1-12: por padrão, NENHUM subdomínio *.trycloudflare.com/*.cloudflareaccess.com
# é aceito no CORS — são domínios de túnel anônimo/gratuito, qualquer um consegue
# um em segundos. Prefira sempre ALLOWED_ORIGINS com o hostname fixo do seu túnel.
# Só ative o wildcard (1) se o hostname do túnel mudar a cada boot e você aceitar
# o risco (dev/staging, nunca produção com dado sensível):
# ALLOW_CLOUDFLARE_WILDCARD=1

# P1-10: teto de sessões interativas do agente simultâneas (chat) — independente
# do teto de jobs agendados (JOBS_MAX_CONCURRENT).
AGENT_MAX_CONCURRENT_SESSIONS=4
# P1-15: cooldown (ms) por domínio entre buscas de vazamento (provider pago) e
# scans ASM — admin pode forçar antes disso com `force:true` no corpo da requisição.
LEAK_SEARCH_COOLDOWN_MS=21600000
ASM_SCAN_COOLDOWN_MS=1800000
# P1-16: teto de páginas do DeHashed (custo) — DEHASHED_PAGE_SIZE * DEHASHED_MAX_PAGES
# é o máximo de resultados buscados por domínio numa única busca.
# DEHASHED_PAGE_SIZE=25
# DEHASHED_MAX_PAGES=4
# P1-18: TTL (ms) do cache do grafo global (GET /api/graph). ?fresh=1 ignora o
# cache pra uma leitura pontual sem esperar o TTL expirar.
GRAPH_CACHE_TTL_MS=30000
# P1-21: batimento periódico de jobs agendados (scheduler.js) e o limite de
# "sem heartbeat há tanto tempo = travado" que o watchdog do jobs-worker usa
# pra liberar a vaga de concorrência sem esperar um restart do backend.
JOB_HEARTBEAT_INTERVAL_MS=60000
JOBS_STALE_MS=600000
# P2-33: máximo de gerações de PDF (Chromium headless) simultâneas.
MAX_CONCURRENT_PDF=3
# P2-35: cifra em repouso (AES-256-GCM) as chaves de API dos leak providers
# (HIBP/DeHashed/LeakCheck Pro) salvas em backend/data/settings.json. Sem esta
# env var, as chaves continuam em texto claro (retrocompat) com aviso no log.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETTINGS_ENCRYPTION_KEY=
